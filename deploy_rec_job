// Job de déploiement
pipeline {
    agent any
    stages {
        stage('Deploy') {
            steps {
                script {
                    def url = "http://env-recette.myapp.local"
                    
                    // Lancer le job de test en lui passant l'URL
                    build job: 'test_e2e_job',
                          parameters: [
                            string(name: 'ENV_URL', value: url)
                          ]
                }
            }
        }
    }
}
