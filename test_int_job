pipeline{
  agent any
  parameters {
    string(name: 'ENV_URL', defaultValue: '')
  }
  stages{
    stage('integration tests'){
      steps{
        sh 'npx cypress run --baseUrl ${params.ENV_URL}'
      }
    }
    //Solution Downstream
    stage('deploy to recette'){
      steps{
        script{
          build job: 'deploy_rec_job'
        }
      }
    }
  }
}
